    <!-- http://purl.obolibrary.org/obo/CL_0000237 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000237">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000079"/>
