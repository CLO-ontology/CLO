        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/uberon/core#human_reference_atlas"/>
        <rdfs:label>smooth muscle cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000192</rdfs:seeAlso>
        <skos:prefLabel>smooth muscle cell</skos:prefLabel>
