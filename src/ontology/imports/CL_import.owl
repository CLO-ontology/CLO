    <!-- http://purl.obolibrary.org/obo/CL_0000082 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000082">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002076"/>
        <obo:IAO_0000115>An epithelial cell of the lung.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cl.owl"/>
        <oboInOwl:hasDbXref>BTO:0004299</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>lung epithelial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/cl#cellxgene_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/cl#human_subset"/>
