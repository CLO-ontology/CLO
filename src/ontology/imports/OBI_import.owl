        <obo:IAO_0000111>material maintenance objective</obo:IAO_0000111>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">An objective specification maintains some or all of the qualities of a material over time.</obo:IAO_0000115>
        <obo:IAO_0000117>PERSON: Bjoern Peters</obo:IAO_0000117>
        <obo:IAO_0000119>PERSON: Bjoern Peters</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
