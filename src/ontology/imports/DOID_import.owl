    <!-- http://purl.obolibrary.org/obo/DOID_3529 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_3529">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050736"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0081337"/>
        <obo:IAO_0000115 xml:lang="en">A congenital myopathy that is characterized by muscle weakness primarily affecting the proximal muscles of the lower limbs beginning in infancy or early childhood, although later onset of symptoms has been reported and that has_material_basis_in heterozygous mutation in the ryanodine receptor-1 gene (RYR1) on chromosome 19q13. Heterozygous mutation in the RYR1 gene also causes susceptibility to malignant hyperthermia-1 (MHS1), patients with CMYP1A are at risk for MHS. Biallelic mutations in the RYR1 gene cause autosomal recessive CMYP1B, which shows overlapping features, but is typically more severe.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
        <oboInOwl:hasDbXref>GARD:6014</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:G71.29</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D020512</oboInOwl:hasDbXref>
