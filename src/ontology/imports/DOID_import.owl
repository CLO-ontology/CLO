        <oboInOwl:hasExactSynonym xml:lang="en">46,XY sex reversal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pure gonadal dysgenesis 46,XY</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Swyer syndrome</oboInOwl:hasExactSynonym>
