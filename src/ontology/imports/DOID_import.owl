        <oboInOwl:hasExactSynonym xml:lang="en">Sulfatidosis, Juvenile, Austin Type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">multiple sulfatase deficiency disease</oboInOwl:hasExactSynonym>
