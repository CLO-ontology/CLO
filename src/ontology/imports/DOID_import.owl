        <oboInOwl:id>DOID:3263</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/doid#NCIthesaurus"/>
        <rdfs:comment xml:lang="en">This disease previously was thought to also have material basis in the SNAI2 gene but that gene likely does not contribute to this disease (see PMID:32975012).</rdfs:comment>
        <rdfs:label xml:lang="en">piebaldism</rdfs:label>
    </owl:Class>
    


