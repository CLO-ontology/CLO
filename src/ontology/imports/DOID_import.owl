        <oboInOwl:hasDbXref>UMLS_CUI:C0039373</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">GM2 gangliosidosis, type 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">hexosaminidase A deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
