    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0111253">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_8712"/>
        <obo:IAO_0000115 xml:lang="en">A neurofibromatosis characterized by multiple cafe-au-lait macules, skin fold freckling, neurofibromas, optic gliomas, Lisch nodules or choroidal abnormalities in the eye, or a specific bone abnormality that has_material_basis_in the NF1 gene on chromosome 17q11.2. Bone abnormalities include a distinctive osseous lesion such as sphenoid dysplasia, anterolateral bowing of the tibia, or pseudarthrosis of a long bone.</obo:IAO_0000115>
