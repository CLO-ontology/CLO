        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:155095006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0013264</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Muscular dystrophy, Duchenne</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:11723</oboInOwl:id>
