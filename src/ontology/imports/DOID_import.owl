        <oboInOwl:hasExactSynonym xml:lang="en">Ehlers-Danlos syndrome type IV</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">autosomal dominant type IV Ehlers-Danlos syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
