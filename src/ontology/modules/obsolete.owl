    <!-- http://purl.obolibrary.org/obo/CLO_0000167 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLO_0000167">
        <obo:IAO_0000115>A disease disposition has been realized by a bearer.</obo:IAO_0000115>
        <obo:IAO_0000117> Allen Xiang</obo:IAO_0000117>
        <obo:IAO_0000117> Yongqun He</obo:IAO_0000117>
        <obo:IAO_0000117> Yu Lin</obo:IAO_0000117>
        <obo:IAO_0000117>Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000231 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000227"/>
        <obo:IAO_0100001 rdf:resource="http://purl.obolibrary.org/obo/RO_0016002"/>
        <rdfs:comment>This is a shortcut relation. It is equivalent to:
participates_in some &apos;disease couse&apos; and realizes some disease</rdfs:comment>
        <rdfs:label>obsolete has disease</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:ObjectProperty>
    


